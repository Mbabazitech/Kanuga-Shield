{
  "name": "kanuga-shield",
  "version": "1.0.0",
  "description": "Modern Enterprise Compliance & Security Automation Platform by Kanuga_tech",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "worker": "node cron-worker.js",
    "build:installer": "node scripts/build-installer.js",
    "deploy": "firebase deploy --project kanugashield",
    "deploy:hosting": "firebase deploy --only hosting --project kanugashield",
    "deploy:functions": "firebase deploy --only functions --project kanugashield"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "@aws-sdk/client-cloudtrail": "^3.758.0",
    "@aws-sdk/client-ec2": "^3.758.0",
    "@aws-sdk/client-iam": "^3.758.0",
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/client-sts": "^3.758.0",
    "@octokit/rest": "^21.1.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^3.0.3",
    "nodemailer": "^10.3.1"
  },
  "keywords": [
    "compliance",
